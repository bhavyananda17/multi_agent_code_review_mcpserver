# Multi-Agent Code Review System - Environment Configuration
# Copy this to .env and fill in your values

# Groq API (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai

# Model Configuration
# Triage + Onboarding: 8B (fast, cheap — routing doesn't need 70B)
# Specialists: 70B-versatile (deep analysis)
MULTIAGENT_MODEL_TRIAGE=llama-3.1-8b-instant
MULTIAGENT_MODEL_SECURITY=llama-3.3-70b-versatile
MULTIAGENT_MODEL_PERFORMANCE=llama-3.3-70b-versatile
MULTIAGENT_MODEL_MODERNIZATION=llama-3.3-70b-versatile
MULTIAGENT_MODEL_SYNTHESIS=llama-3.3-70b-versatile
# Self-evaluation judge. If unset it reuses MULTIAGENT_MODEL_SYNTHESIS (then the built-in default).
MULTIAGENT_MODEL_EVAL=llama-3.3-70b-versatile
MULTIAGENT_MODEL_DOCUMENTATION=llama-3.1-8b-instant
MULTIAGENT_MODEL_ONBOARDING=llama-3.1-8b-instant

# Rate Limits (Groq free tier: 30 RPM, 6000 TPM)
RPM_LIMIT=30
MULTIAGENT_TPM_LIMIT=6000

# GitHub (OPTIONAL) - only used by --issue / the "issue" tool argument.
# Public repos need no token (60 requests/hour per IP). For private repos, use a fine-grained
# token with read-only "Issues" access to just the repos you review. Sent only to api.github.com.
# MULTIAGENT_GITHUB_TOKEN=

# Self-evaluation stage (all OPTIONAL; shown with defaults)
# Scores each finding 1-3 on relevance, severity accuracy and actionability (max 9).
# Findings scoring below the threshold are flagged low-confidence.
# MULTIAGENT_EVAL_ENABLED=true
# MULTIAGENT_EVAL_THRESHOLD=5
# MULTIAGENT_EVAL_EXCLUDE_LOW_CONFIDENCE=false   # false: separate report section, true: drop them
# MULTIAGENT_EVAL_BATCH_SIZE=8                   # findings scored per LLM call
