# Multi-Agent Code Review System - Environment Configuration
# Copy this to .env and fill in your values

# Groq API (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai

# Model Configuration
# Groq retires models regularly: a role pointing at a retired model fails with 404 (triage has no fallback).
# List what your key can use with:  curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Triage + Onboarding: a small model (routing doesn't need a large one). Specialists: a large model.
MULTIAGENT_MODEL_TRIAGE=openai/gpt-oss-20b
MULTIAGENT_MODEL_SECURITY=openai/gpt-oss-120b
MULTIAGENT_MODEL_PERFORMANCE=openai/gpt-oss-120b
MULTIAGENT_MODEL_LOGIC=openai/gpt-oss-120b
MULTIAGENT_MODEL_MODERNIZATION=openai/gpt-oss-120b
MULTIAGENT_MODEL_SYNTHESIS=openai/gpt-oss-120b
MULTIAGENT_MODEL_DOCUMENTATION=openai/gpt-oss-20b
MULTIAGENT_MODEL_ONBOARDING=openai/gpt-oss-20b
# Self-evaluation judge. If unset it reuses MULTIAGENT_MODEL_SYNTHESIS, i.e. the SAME model that wrote the findings,
# and LLM judges tend to favour their own model's output (the report says so). Prefer a different family:
# MULTIAGENT_MODEL_EVAL=qwen/qwen3.8-27b

# GitHub (OPTIONAL) - only used by --issue / the "issue" tool argument.
# Public repos need no token (60 requests/hour per IP). For private repos, use a fine-grained
# token with read-only "Issues" access to just the repos you review. Sent only to api.github.com.
# MULTIAGENT_GITHUB_TOKEN=

# Self-evaluation stage (all OPTIONAL; shown with defaults)
# Scores each finding 1-3 on relevance, severity accuracy and actionability (max 9).
# Findings scoring below the threshold are flagged low-confidence.
# MULTIAGENT_GROUNDING_ENABLED=true             # verify each finding's quoted code exists in the commit (no LLM call)
# MULTIAGENT_STATIC_ANALYSIS=true               # Roslyn complexity / call-site / smell context for the specialists
# MULTIAGENT_EVAL_ENABLED=true
# MULTIAGENT_EVAL_THRESHOLD=5
# MULTIAGENT_EVAL_EXCLUDE_LOW_CONFIDENCE=false   # false: separate report section, true: drop them
# MULTIAGENT_EVAL_BATCH_SIZE=8                   # findings scored per LLM call
